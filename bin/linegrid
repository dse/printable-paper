#!/usr/bin/env perl
use warnings;
use strict;
use open qw(locale);

# TODO
#     --spacing=1/10in,1/2in,1in
#     --spacing=1mm,5mm,10mm

our $strokeWidth = '1/600in';
our $dashArray;
our $color = '#000000';
our $paperSize = 'halfletter';
our $spacing = '5mm';
our $major = '3, 4';
our $dx;
our $dy;

use Getopt::Long;
Getopt::Long::Configure(qw(getopt_compat bundling no_ignore_case));
Getopt::Long::GetOptions(
    'w|stroke-width=s' => \$strokeWidth,
    'd|dash-array=s' => \$dashArray,
    'c|color=s' => \$color,
    'p|paper-size=s' => \$paperSize,
    's|spacing=s' => \$spacing,
    'm|major=s' => \$major,
    'dx=s' => \$dx,
    'dy=s' => \$dy,
) or die();

our @strokeWidth = defined $strokeWidth ? (map { parseDimen($_) } split(/[,\s]+/, $strokeWidth)) : (parseDimen('4/600in'));
our @dashArray   = defined $dashArray   ? (map { parseDimen($_) } split(/[,\s]+/, $dashArray))   : ();
our @major       = defined $major       ? (map { 0 + $_ }         split(/[,\s]+/, $major))       : ();
$spacing = defined $spacing ? parseDimen($spacing) : parseDimen('6mm');
$dx      = defined $dx ? parseDimen($dx) : 0;
$dy      = defined $dy ? parseDimen($dy) : 0;

use FindBin;
use lib "${FindBin::Bin}/../lib";

use My::RuledPaper;
use My::RuledPaper::Constants qw(:all);
use My::RuledPaper::Dimen qw(parseDimen);
use My::RuledPaper::MonkeyPatch::Drawing;

use POSIX qw(floor);
use List::Util qw(all);
use Scalar::Util qw(looks_like_number);

my $GRID_COLOR = $color // COLOR_NON_REPRO_BLUE;

my $STROKE_WIDTH_0 = $strokeWidth[0];
my $STROKE_WIDTH_1 = $strokeWidth[1];
my $STROKE_WIDTH_2 = $strokeWidth[2];

my @STROKE_DASH_ARRAY = @dashArray;
my $STROKE_DASH_ARRAY = scalar @dashArray ? join(' ', @STROKE_DASH_ARRAY) : 'none';

my $style = shift(@ARGV) // '10';

my $p = My::RuledPaper->new(HALF_LETTER);

$p->{style} = <<"END";
line, rect {
    fill: none;
    stroke: ${GRID_COLOR};
    stroke-linecap: butt;
    stroke-linejoin: miter;
    stroke-dasharray: ${STROKE_DASH_ARRAY};
}
.strokeA {
    stroke-width: ${STROKE_WIDTH_0}px;
}
.strokeB {
    stroke-width: ${STROKE_WIDTH_1}px;
}
.strokeC {
    stroke-width: ${STROKE_WIDTH_2}px;
}
END

use POSIX qw(floor);

my $cx = $p->{width} / 2 + $dx;
my $cy = $p->{height} / 2 + $dy;

my $startX = -floor($p->{width}  / 2 / $spacing);
my $endX   =  floor($p->{width}  / 2 / $spacing);
my $startY = -floor($p->{height} / 2 / $spacing);
my $endY   =  floor($p->{height} / 2 / $spacing);

my $x1 = 0;
my $x2 = $p->{width};
my $y1 = 0;
my $y2 = $p->{height};

my $margin = 0.25 * IN;
my $xLines = floor( ($p->{width}  / 2 - $margin) / $spacing );
my $yLines = floor( ($p->{height} / 2 - $margin) / $spacing );

my $centerX = 0;
my $centerY = 0;
my $bigMajor = defined $major[1] ? $major[0] * $major[1] : $major[0];
if (defined $bigMajor && $bigMajor % 2 == 0) {
    # may have to shift the major grid divisions over to maximize the
    # number of them.
    if ($xLines % $bigMajor >= $bigMajor / 2) {
        $centerX = $bigMajor / 2;
    }
    if ($yLines % $bigMajor >= $bigMajor / 2) {
        $centerY = $bigMajor / 2;
    }
}
warn("bigMajor is $bigMajor\n");
warn("xLines is $xLines\n");
warn("yLines is $yLines\n");
warn("centerX is $centerX\n");
warn("centerY is $centerY\n");

my $full = 1;

my $startXX = $full ? 0            : $cx + $startX * $spacing;
my $endXX   = $full ? $p->{width}  : $cx + $endX   * $spacing;
my $startYY = $full ? 0            : $cy + $startY * $spacing;
my $endYY   = $full ? $p->{height} : $cy + $endY   * $spacing;

for (my $x = $startX; $x <= $endX; $x += 1) {
    my $xx = $cx + $x * $spacing;
    my $class = 'strokeA';
    if (defined $major[1] && ($x + $centerX) % ($major[0] * $major[1]) == 0) {
        $class = 'strokeC';
    } elsif (defined $major[0] && ($x + $centerX) % $major[0] == 0) {
        $class = 'strokeB';
    }
    $p->line($xx, $startYY, $xx, $endYY, class => $class);
}
for (my $y = $startY; $y <= $endY; $y += 1) {
    my $yy = $cy + $y * $spacing;
    my $class = 'strokeA';
    if (defined $major[1] && ($y + $centerY) % ($major[0] * $major[1]) == 0) {
        $class = 'strokeC';
    } elsif (defined $major[0] && ($y + $centerY) % $major[0] == 0) {
        $class = 'strokeB';
    }
    $p->line($startXX, $yy, $endXX, $yy, class => $class);
}

print($p->svg());
