#!/usr/bin/env perl
use warnings;
use strict;
use open IO => ':locale';

use File::Basename qw(basename);
our $PROGNAME = basename($0);
$PROGNAME =~ s{\.pl$}{};

our $optStrokeWidth = '1/600in';
our $optDashArray;
our $optColor;
our $optPaperSize = 'halfletter';
our $optSpacing = '5mm';
our $optDx;
our $optDy;

use Getopt::Long;
Getopt::Long::Configure(qw(getopt_compat bundling no_ignore_case));
Getopt::Long::GetOptions(
    'w|stroke-width=s' => \$optStrokeWidth,
    'd|dash-array=s' => \$optDashArray,
    'c|color=s' => \$optColor,
    'p|paper-size=s' => \$optPaperSize,
    's|spacing=s' => \$optSpacing,
    'dx=s' => \$optDx,
    'dy=s' => \$optDy,
) or die();

our @strokeWidth = defined $optStrokeWidth ? (map { parseDimen($_) } split(/[,\s]+/, $optStrokeWidth)) : (parseDimen('4/600in'));
our @dashArray   = defined $optDashArray   ? (map { parseDimen($_) } split(/[,\s]+/, $optDashArray))   : ();
our @spacing     = defined $optSpacing     ? (map { parseDimen($_) } split(/[,\s]+/, $optSpacing))     : parseDimen('6mm');
our $spacing     = $spacing[0];
our @divisions   = map { round($_ / $spacing[0]) } @spacing;
our $dx          = defined $optDx ? parseDimen($optDx) : 0;
our $dy          = defined $optDy ? parseDimen($optDy) : 0;

use FindBin;
use lib "${FindBin::Bin}/../lib";

use My::RuledPaper;
use My::RuledPaper::Constants qw(:all);
use My::RuledPaper::Dimen qw(parseDimen);
use My::RuledPaper::MonkeyPatch::Drawing;
use My::RuledPaper::Parse::Dimension qw(parseDimension);
use My::RuledPaper::Parse::GridStyle qw(parseGridStyle);
use My::RuledPaper::Parse::PaperSize qw(parsePaperSize);

use POSIX qw(floor round);
use List::Util qw(all);
use Scalar::Util qw(looks_like_number);
use Data::Dumper qw(Dumper);

our @paperSize;
our $gridStyle;
our $gridType = $PROGNAME;
our $strokeWidths = ["1/600in", "2/600in", "4/600in"];

use Getopt::Long;
Getopt::Long::Configure(qw(gnu_compat bundling no_ignore_case));
Getopt::Long::GetOptions(
    'page-size|paper-size|size=s' => sub { @paperSize = parsePaperSize($_[1]); },
    'grid-style|style=s'          => sub { $gridStyle = $_[1]; },
    'letter'                      => sub { @paperSize = LETTER; },
    'half-letter'                 => sub { @paperSize = HALF_LETTER; },
    'a5'                          => sub { @paperSize = A5; },
    'a4'                          => sub { @paperSize = A4; },
    'dot|dot-grid'                => sub { $gridType = 'dotgrid'; },
    'line|line-grid'              => sub { $gridType = 'linegrid'; },
    'stroke-widths=s'             => \$strokeWidths,
) or die();

if (!scalar @paperSize) {
    @paperSize = parsePaperSize('letter');
}

if (ref $strokeWidths eq '') {
    $strokeWidths = [split(/[\s,]+/, $strokeWidths)];
    $strokeWidths = [grep { /\S/ } @$strokeWidths];
}
$strokeWidths = [map { parseDimension($_) } @$strokeWidths];

my $GRID_COLOR = $optColor // COLOR_NON_REPRO_BLUE;

my $STROKE_WIDTH_0 = $strokeWidth[0];
my $STROKE_WIDTH_1 = $strokeWidth[1];
my $STROKE_WIDTH_2 = $strokeWidth[2];

my @STROKE_DASH_ARRAY = @dashArray;
my $STROKE_DASH_ARRAY = scalar @dashArray ? join(' ', @STROKE_DASH_ARRAY) : 'none';

my $FEINT_DOT_WIDTH = 6/600 * IN;
my $MINOR_DOT_WIDTH = 8/600 * IN;
my $MAJOR_DOT_WIDTH = 10/600 * IN;

my $FONT_SIZE = 6 * PT;
my $TEXT_DOWN = 0.3 * $FONT_SIZE; # inkscape svg->pdf does not support css transform

if (!defined $gridStyle) {
    $gridStyle = '2.5mm,10';
}

$gridStyle = '2mm,12'   if $gridStyle eq '12';
$gridStyle = '2mm,4,12' if $gridStyle eq '412';
$gridStyle = '2mm,3,12' if $gridStyle eq '312';
$gridStyle = '2.5mm,10' if $gridStyle eq '10';

my ($spacing, $minor, $major) = parseGridStyle($gridStyle);

if (scalar @$strokeWidths < 3 && defined $major) {
    die("not enough stroke widths\n");
}
if (scalar @$strokeWidths < 2 && defined $minor) {
    die("not enough stroke widths\n");
}

for (my $i = 0; $i < $#$strokeWidths; $i += 1) {
    my $j = $i + 1;
    if (lessThanOrNearEqual($strokeWidths->[$j], $strokeWidths->[$i])) {
        die("invalid set of stroke widths\n");
    }
}
if (defined $minor && $minor <= 1) {
    die("minor grid number must be greater than one");
}
if (defined $major && $major <= 1) {
    die("major grid number must be greater than one");
}
if (defined $major && defined $minor && ($major <= $minor || $major % $minor != 0)) {
    die("major grid number must be a multiple of, and greater than,  minor grid number\n");
}

# account for floating point rounding errors
sub greaterThanOrNearEqual {
    my ($a, $b) = @_;
    return abs($a - $b) < 0.000001 || $a > $b;
}
sub lessThanOrNearEqual {
    my ($a, $b) = @_;
    return $a < $b || abs($a - $b) < 0.000001;
}

my $p = My::RuledPaper->new();
$p->{width} = $paperSize[0];
$p->{height} = $paperSize[1];

$p->{style} = <<"END";
line, rect {
    fill: none;
    stroke: ${GRID_COLOR};
    stroke-linecap: butt;
    stroke-linejoin: miter;
    stroke-dasharray: ${STROKE_DASH_ARRAY};
}
.strokeA {
    stroke-width: ${STROKE_WIDTH_0}px;
}
.strokeB {
    stroke-width: ${STROKE_WIDTH_1}px;
}
.strokeC {
    stroke-width: ${STROKE_WIDTH_2}px;
}
text {
    text-anchor: middle;
    font-family: 'Times New Roman', 'Times Roman', serif;
    font-size: ${FONT_SIZE}px;
    fill: ${NON_REPRO_BLUE};
}
circle {
    fill: ${NON_REPRO_BLUE};
}
END

use POSIX qw(floor);

my $cx = $p->{width} / 2 + $dx;
my $cy = $p->{height} / 2 + $dy;

my $startX = -floor($p->{width}  / 2 / $spacing);
my $endX   =  floor($p->{width}  / 2 / $spacing);
my $startY = -floor($p->{height} / 2 / $spacing);
my $endY   =  floor($p->{height} / 2 / $spacing);

my $x1 = 0;
my $x2 = $p->{width};
my $y1 = 0;
my $y2 = $p->{height};

my $margin = 0.25 * IN;
my $xLines = floor( ($p->{width}  / 2 - $margin) / $spacing );
my $yLines = floor( ($p->{height} / 2 - $margin) / $spacing );

my $centerX = 0;
my $centerY = 0;
my $bigSpacing = $spacing[2] // $spacing[1] // $spacing[0];
if (defined $spacing[1]) {
    my $bigDivisions = $divisions[2] // $divisions[1];
    if (defined $bigDivisions && $bigDivisions % 2 == 0) {
        # may have to shift the divisions grid divisions over to maximize the
        # number of them.
        if ($xLines % $bigDivisions >= $bigDivisions / 2) {
            $centerX = $bigDivisions / 2;
        }
        if ($yLines % $bigDivisions >= $bigDivisions / 2) {
            $centerY = $bigDivisions / 2;
        }
    }
}

my $full = 1;

my $startXX = $full ? 0            : $cx + $startX * $spacing;
my $endXX   = $full ? $p->{width}  : $cx + $endX   * $spacing;
my $startYY = $full ? 0            : $cy + $startY * $spacing;
my $endYY   = $full ? $p->{height} : $cy + $endY   * $spacing;

for (my $x = $startX; $x <= $endX; $x += 1) {
    my $xx = $cx + $x * $spacing;
    my $class = 'strokeA';
    if (defined $divisions[2] && ($x + $centerX) % $divisions[2] == 0) {
        $class = 'strokeC';
    } elsif (defined $divisions[1] && ($x + $centerX) % $divisions[1] == 0) {
        $class = 'strokeB';
    }
    $p->line($xx, $startYY, $xx, $endYY, class => $class);
}
for (my $y = $startY; $y <= $endY; $y += 1) {
    my $yy = $cy + $y * $spacing;
    my $class = 'strokeA';
    if (defined $divisions[2] && ($y + $centerY) % ($divisions[2]) == 0) {
        $class = 'strokeC';
    } elsif (defined $divisions[1] && ($y + $centerY) % $divisions[1] == 0) {
        $class = 'strokeB';
    }
}


print($p->svg());
