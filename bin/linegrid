#!/usr/bin/env perl
use warnings;
use strict;
use open qw(locale);

our $optStrokeWidth = '1/600in';
our $optDashArray;
our $optColor = '#000000';
our $optPaperSize = 'halfletter';
our $optSpacing = '5mm';
our $optDx;
our $optDy;

use Getopt::Long;
Getopt::Long::Configure(qw(getopt_compat bundling no_ignore_case));
Getopt::Long::GetOptions(
    'w|stroke-width=s' => \$optStrokeWidth,
    'd|dash-array=s' => \$optDashArray,
    'c|color=s' => \$optColor,
    'p|paper-size=s' => \$optPaperSize,
    's|spacing=s' => \$optSpacing,
    'dx=s' => \$optDx,
    'dy=s' => \$optDy,
) or die();

our @strokeWidth = defined $optStrokeWidth ? (map { parseDimen($_) } split(/[,\s]+/, $optStrokeWidth)) : (parseDimen('4/600in'));
our @dashArray   = defined $optDashArray   ? (map { parseDimen($_) } split(/[,\s]+/, $optDashArray))   : ();
our @spacing     = defined $optSpacing     ? (map { parseDimen($_) } split(/[,\s]+/, $optSpacing))     : parseDimen('6mm');
our $spacing     = $spacing[0];
our @divisions   = map { round($_ / $spacing[0]) } @spacing;
our $dx          = defined $optDx ? parseDimen($optDx) : 0;
our $dy          = defined $optDy ? parseDimen($optDy) : 0;

use FindBin;
use lib "${FindBin::Bin}/../lib";

use My::RuledPaper;
use My::RuledPaper::Constants qw(:all);
use My::RuledPaper::Dimen qw(parseDimen);
use My::RuledPaper::MonkeyPatch::Drawing;

use POSIX qw(floor round);
use List::Util qw(all);
use Scalar::Util qw(looks_like_number);

my $GRID_COLOR = $optColor // COLOR_NON_REPRO_BLUE;

my $STROKE_WIDTH_0 = $strokeWidth[0];
my $STROKE_WIDTH_1 = $strokeWidth[1];
my $STROKE_WIDTH_2 = $strokeWidth[2];

my @STROKE_DASH_ARRAY = @dashArray;
my $STROKE_DASH_ARRAY = scalar @dashArray ? join(' ', @STROKE_DASH_ARRAY) : 'none';

my $style = shift(@ARGV) // '10';

my $p = My::RuledPaper->new(HALF_LETTER);

$p->{style} = <<"END";
line, rect {
    fill: none;
    stroke: ${GRID_COLOR};
    stroke-linecap: butt;
    stroke-linejoin: miter;
    stroke-dasharray: ${STROKE_DASH_ARRAY};
}
.strokeA {
    stroke-width: ${STROKE_WIDTH_0}px;
}
.strokeB {
    stroke-width: ${STROKE_WIDTH_1}px;
}
.strokeC {
    stroke-width: ${STROKE_WIDTH_2}px;
}
END

use POSIX qw(floor);

my $cx = $p->{width} / 2 + $dx;
my $cy = $p->{height} / 2 + $dy;

my $startX = -floor($p->{width}  / 2 / $spacing);
my $endX   =  floor($p->{width}  / 2 / $spacing);
my $startY = -floor($p->{height} / 2 / $spacing);
my $endY   =  floor($p->{height} / 2 / $spacing);

my $x1 = 0;
my $x2 = $p->{width};
my $y1 = 0;
my $y2 = $p->{height};

my $margin = 0.25 * IN;
my $xLines = floor( ($p->{width}  / 2 - $margin) / $spacing );
my $yLines = floor( ($p->{height} / 2 - $margin) / $spacing );

my $centerX = 0;
my $centerY = 0;
my $bigSpacing = $spacing[2] // $spacing[1] // $spacing[0];
if (defined $spacing[1]) {
    my $bigDivisions = $divisions[2] // $divisions[1];
    if (defined $bigDivisions && $bigDivisions % 2 == 0) {
        # may have to shift the divisions grid divisions over to maximize the
        # number of them.
        if ($xLines % $bigDivisions >= $bigDivisions / 2) {
            $centerX = $bigDivisions / 2;
        }
        if ($yLines % $bigDivisions >= $bigDivisions / 2) {
            $centerY = $bigDivisions / 2;
        }
    }
}

my $full = 1;

my $startXX = $full ? 0            : $cx + $startX * $spacing;
my $endXX   = $full ? $p->{width}  : $cx + $endX   * $spacing;
my $startYY = $full ? 0            : $cy + $startY * $spacing;
my $endYY   = $full ? $p->{height} : $cy + $endY   * $spacing;

for (my $x = $startX; $x <= $endX; $x += 1) {
    my $xx = $cx + $x * $spacing;
    my $class = 'strokeA';
    if (defined $divisions[2] && ($x + $centerX) % $divisions[2] == 0) {
        $class = 'strokeC';
    } elsif (defined $divisions[1] && ($x + $centerX) % $divisions[1] == 0) {
        $class = 'strokeB';
    }
    $p->line($xx, $startYY, $xx, $endYY, class => $class);
}
for (my $y = $startY; $y <= $endY; $y += 1) {
    my $yy = $cy + $y * $spacing;
    my $class = 'strokeA';
    if (defined $divisions[2] && ($y + $centerY) % ($divisions[2]) == 0) {
        $class = 'strokeC';
    } elsif (defined $divisions[1] && ($y + $centerY) % $divisions[1] == 0) {
        $class = 'strokeB';
    }
    $p->line($startXX, $yy, $endXX, $yy, class => $class);
}

print($p->svg());
